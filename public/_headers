# Cloudflare static asset headers. https://developers.cloudflare.com/pages/configuration/headers/
# ponytail: no CSP yet; Angular's inline critical CSS needs hashes, add it in Fase 3 with "security.autoCsp".

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Hashed build output never changes under the same name: cache for a year.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=31536000, immutable
